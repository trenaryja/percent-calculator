{
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"fix": "prettier -w . && eslint --fix .",
		"check": "rm -rf .next && tsc && prettier -c . && eslint . && bun run build",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install"
	},
	"dependencies": {
		"@mantine/hooks": "^9.5.1",
		"@trenaryja/ui": "^0.0.1-37",
		"daisyui": "^5.7.17",
		"next": "^16.3.1",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"remeda": "^2.40.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@trenaryja/config": "^0.0.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4"
	},
	"prettier": "@trenaryja/config/prettier",
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver"
	],
	"postcss": {
